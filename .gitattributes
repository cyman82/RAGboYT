# Auto detect text files and normalize line endings to LF
* text=auto

# Text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.py text eol=lf
*.html text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.crx binary
*.zip binary
